<?xml version="1.0" encoding="UTF-8"?>
<!--
  Asylverfahren — CMMN 1.1 reconstruction of the customer-supplied diagram
  (see asyl-verfahren.source-diagram.svg, a cmmn-js export).

  WHY THIS FILE IS HAND-AUTHORED, AND WHAT IS AN ASSUMPTION
  ========================================================
  The supplied diagram carries NO connections into any of its ten entry criteria:
  every edge in the SVG is a dashed association to a text annotation. The
  dependency logic lives entirely in German prose on those annotations
  ("Sobald beide Tasks erledigt", "Sobald die 3 Tasks erledigt", "Antrag
  gestellt", "Person erfasst", "Antrag registriert").

  The sentries below are therefore OUR READING of that prose, not something
  recovered from the model. They are to be reviewed with the customer. Each
  inferred sentry is marked ASSUMPTION with the annotation it derives from.

  Element ids (CasePlanModel_09iqv6o, PlanItem_*, EntryCriterion_*,
  TextAnnotation_*) and all DI coordinates are copied verbatim from the supplied
  SVG, so generated case definitions can point back at the customer's own
  diagram and so the importer's stage-ordering runs on real geometry.
-->
<cmmn:definitions xmlns:cmmn="http://www.omg.org/spec/CMMN/20151109/MODEL"
                  xmlns:cmmndi="http://www.omg.org/spec/CMMN/20151109/CMMNDI"
                  xmlns:dc="http://www.omg.org/spec/CMMN/20151109/DC"
                  xmlns:di="http://www.omg.org/spec/CMMN/20151109/DI"
                  id="Definitions_asyl_verfahren"
                  targetNamespace="http://bpmn.io/schema/cmmn"
                  exporter="hand-authored from customer diagram"
                  exporterVersion="1.0">
  <cmmn:case id="asyl-verfahren" name="Asylverfahren">
    <cmmn:casePlanModel id="CasePlanModel_09iqv6o" name="Asylverfahren">

      <!-- ============ Task and milestone definitions ============ -->
      <cmmn:humanTask id="HumanTask_ed_behandlung" name="ED Behandlung"/>
      <cmmn:humanTask id="HumanTask_screening" name="Screening durchführen/prüfen"/>
      <cmmn:humanTask id="HumanTask_antragstellung" name="Antragstellung entgegennehmen"/>
      <cmmn:humanTask id="HumanTask_meldung_registrierungsbehoerde" name="Meldung an Registrierungsbehörde (Fristen..)"/>
      <cmmn:humanTask id="HumanTask_antragsregistrierung" name="Antragsregistrierung (Fristen..)"/>
      <cmmn:humanTask id="HumanTask_ladung_erstellt" name="Ladung erstellt"/>
      <cmmn:humanTask id="HumanTask_einreichungsplanung" name="Einreichungsplanung"/>
      <cmmn:humanTask id="HumanTask_antragseinreichung" name="Antragseinreichung"/>
      <cmmn:humanTask id="HumanTask_kat1_pruefen" name="weitere Angabe bei KAT I Treffer prüfen"/>
      <cmmn:humanTask id="HumanTask_pruefung_weitere_angaben" name="Prüfung der weiteren Angaben"/>

      <cmmn:milestone id="Milestone_person_erfasst" name="Person erfasst"/>
      <cmmn:milestone id="Milestone_antrag_gestellt" name="Antrag gestellt"/>
      <cmmn:milestone id="Milestone_antrag_registriert" name="Antrag registriert"/>
      <cmmn:milestone id="Milestone_antrag_eingereicht" name="Antrag eingereicht"/>
      <cmmn:milestone id="Milestone_antragsgestattung_erteilt" name="Antragsgestattung erteilt"/>
      <cmmn:milestone id="Milestone_anhoerung_angesetzt" name="Anhörung angesetzt"/>

      <!-- ============ Stage: Vorverfahren (NPOL/LPOL) ============ -->
      <cmmn:stage id="Stage_vorverfahren" name="Vorverfahren (NPOL/LPOL)">
        <cmmn:planItem id="PlanItem_1asz30q" definitionRef="HumanTask_ed_behandlung"/>
        <cmmn:planItem id="PlanItem_0ihb3fo" definitionRef="HumanTask_screening"/>
        <cmmn:planItem id="PlanItem_1te867s" definitionRef="Milestone_person_erfasst">
          <cmmn:entryCriterion id="EntryCriterion_1hlbicy" sentryRef="Sentry_person_erfasst"/>
        </cmmn:planItem>

        <!-- ASSUMPTION, from TextAnnotation_1g2goyg "Sobald beide Tasks erledigt":
             both tasks in this stage must complete. -->
        <cmmn:sentry id="Sentry_person_erfasst">
          <cmmn:planItemOnPart id="OnPart_pe_1" sourceRef="PlanItem_1asz30q">
            <cmmn:standardEvent>complete</cmmn:standardEvent>
          </cmmn:planItemOnPart>
          <cmmn:planItemOnPart id="OnPart_pe_2" sourceRef="PlanItem_0ihb3fo">
            <cmmn:standardEvent>complete</cmmn:standardEvent>
          </cmmn:planItemOnPart>
        </cmmn:sentry>
      </cmmn:stage>

      <!-- ============ Stage: Registrierung ============ -->
      <cmmn:stage id="Stage_registrierung" name="Registrierung">
        <cmmn:planItem id="PlanItem_19x2xyj" definitionRef="HumanTask_meldung_registrierungsbehoerde"/>
        <cmmn:planItem id="PlanItem_17dzvyt" definitionRef="HumanTask_antragsregistrierung"/>
        <cmmn:planItem id="PlanItem_067mr79" definitionRef="Milestone_antrag_registriert">
          <cmmn:entryCriterion id="EntryCriterion_0e3qzys" sentryRef="Sentry_antrag_registriert"/>
        </cmmn:planItem>

        <!-- ASSUMPTION, from TextAnnotation_00m7x3z "Sobald beide Tasks erledigt". -->
        <cmmn:sentry id="Sentry_antrag_registriert">
          <cmmn:planItemOnPart id="OnPart_ar_1" sourceRef="PlanItem_19x2xyj">
            <cmmn:standardEvent>complete</cmmn:standardEvent>
          </cmmn:planItemOnPart>
          <cmmn:planItemOnPart id="OnPart_ar_2" sourceRef="PlanItem_17dzvyt">
            <cmmn:standardEvent>complete</cmmn:standardEvent>
          </cmmn:planItemOnPart>
        </cmmn:sentry>
      </cmmn:stage>

      <!-- ============ Stage: Einreichung ============
           Carries a manual-activation marker in the source diagram, and a
           planning table holding the one discretionary item. -->
      <cmmn:stage id="Stage_einreichung" name="Einreichung">
        <cmmn:planItem id="PlanItem_11oy1wh" definitionRef="HumanTask_ladung_erstellt"/>
        <cmmn:planItem id="PlanItem_0ad1ysa" definitionRef="HumanTask_einreichungsplanung"/>
        <cmmn:planItem id="PlanItem_0tst5di" definitionRef="HumanTask_antragseinreichung"/>
        <cmmn:planItem id="PlanItem_1qb2dwp" definitionRef="Milestone_antrag_eingereicht">
          <cmmn:entryCriterion id="EntryCriterion_16pe5b9" sentryRef="Sentry_antrag_eingereicht"/>
        </cmmn:planItem>

        <!-- ASSUMPTION, from TextAnnotation_1s45p3q "Sobald die 3 Tasks erledigt". -->
        <cmmn:sentry id="Sentry_antrag_eingereicht">
          <cmmn:planItemOnPart id="OnPart_ae_1" sourceRef="PlanItem_11oy1wh">
            <cmmn:standardEvent>complete</cmmn:standardEvent>
          </cmmn:planItemOnPart>
          <cmmn:planItemOnPart id="OnPart_ae_2" sourceRef="PlanItem_0ad1ysa">
            <cmmn:standardEvent>complete</cmmn:standardEvent>
          </cmmn:planItemOnPart>
          <cmmn:planItemOnPart id="OnPart_ae_3" sourceRef="PlanItem_0tst5di">
            <cmmn:standardEvent>complete</cmmn:standardEvent>
          </cmmn:planItemOnPart>
        </cmmn:sentry>

        <cmmn:planningTable id="PlanningTable_einreichung">
          <cmmn:discretionaryItem id="PlanItem_18axmw4" definitionRef="HumanTask_kat1_pruefen"/>
        </cmmn:planningTable>
      </cmmn:stage>

      <!-- ============ Case-plan-level plan items ============ -->
      <cmmn:planItem id="PlanItem_181t6jt" definitionRef="Stage_vorverfahren"/>

      <cmmn:planItem id="PlanItem_1vnasux" definitionRef="HumanTask_antragstellung"/>

      <cmmn:planItem id="PlanItem_0fjixce" definitionRef="Milestone_antrag_gestellt">
        <cmmn:entryCriterion id="EntryCriterion_1v7531s" sentryRef="Sentry_antrag_gestellt"/>
      </cmmn:planItem>

      <!-- The Registrierung stage is fed by TWO separate criteria in the source
           diagram, annotated "Antrag gestellt" (TextAnnotation_0v3mufb) and
           "Person erfasst" (TextAnnotation_0ez19g4) — hence two entry criteria
           rather than one two-part sentry. ASSUMPTION. -->
      <cmmn:planItem id="PlanItem_08fqej5" definitionRef="Stage_registrierung">
        <cmmn:entryCriterion id="EntryCriterion_1dzva64" sentryRef="Sentry_reg_antrag_gestellt"/>
        <cmmn:entryCriterion id="EntryCriterion_11tvsx7" sentryRef="Sentry_reg_person_erfasst"/>
      </cmmn:planItem>

      <!-- ASSUMPTION, from TextAnnotation_1q8az8a "Antrag registriert". The stage
           also carries a manual-activation marker in the diagram. -->
      <cmmn:planItem id="PlanItem_1hsqx8y" definitionRef="Stage_einreichung">
        <cmmn:entryCriterion id="EntryCriterion_147bq4o" sentryRef="Sentry_einreichung"/>
        <cmmn:itemControl id="ItemControl_einreichung">
          <cmmn:manualActivationRule id="ManualActivationRule_einreichung">
            <cmmn:condition id="Condition_einreichung">true</cmmn:condition>
          </cmmn:manualActivationRule>
        </cmmn:itemControl>
      </cmmn:planItem>

      <cmmn:planItem id="PlanItem_06xryvs" definitionRef="Milestone_antragsgestattung_erteilt">
        <cmmn:entryCriterion id="EntryCriterion_06by40o" sentryRef="Sentry_antragsgestattung"/>
      </cmmn:planItem>

      <cmmn:planItem id="PlanItem_0br7vvk" definitionRef="HumanTask_pruefung_weitere_angaben">
        <cmmn:entryCriterion id="EntryCriterion_1220odh" sentryRef="Sentry_pruefung_weitere_angaben"/>
      </cmmn:planItem>

      <cmmn:planItem id="PlanItem_0gsqv2s" definitionRef="Milestone_anhoerung_angesetzt">
        <cmmn:entryCriterion id="EntryCriterion_1s91op2" sentryRef="Sentry_anhoerung"/>
      </cmmn:planItem>

      <!-- ============ Case-plan-level sentries (all ASSUMPTIONS) ============ -->

      <!-- Antragstellung entgegennehmen completes. -->
      <cmmn:sentry id="Sentry_antrag_gestellt">
        <cmmn:planItemOnPart id="OnPart_ag_1" sourceRef="PlanItem_1vnasux">
          <cmmn:standardEvent>complete</cmmn:standardEvent>
        </cmmn:planItemOnPart>
      </cmmn:sentry>

      <cmmn:sentry id="Sentry_reg_antrag_gestellt">
        <cmmn:planItemOnPart id="OnPart_rag_1" sourceRef="PlanItem_0fjixce">
          <cmmn:standardEvent>occur</cmmn:standardEvent>
        </cmmn:planItemOnPart>
      </cmmn:sentry>

      <cmmn:sentry id="Sentry_reg_person_erfasst">
        <cmmn:planItemOnPart id="OnPart_rpe_1" sourceRef="PlanItem_1te867s">
          <cmmn:standardEvent>occur</cmmn:standardEvent>
        </cmmn:planItemOnPart>
      </cmmn:sentry>

      <cmmn:sentry id="Sentry_einreichung">
        <cmmn:planItemOnPart id="OnPart_ein_1" sourceRef="PlanItem_067mr79">
          <cmmn:standardEvent>occur</cmmn:standardEvent>
        </cmmn:planItemOnPart>
      </cmmn:sentry>

      <cmmn:sentry id="Sentry_antragsgestattung">
        <cmmn:planItemOnPart id="OnPart_age_1" sourceRef="PlanItem_1qb2dwp">
          <cmmn:standardEvent>occur</cmmn:standardEvent>
        </cmmn:planItemOnPart>
      </cmmn:sentry>

      <cmmn:sentry id="Sentry_pruefung_weitere_angaben">
        <cmmn:planItemOnPart id="OnPart_pwa_1" sourceRef="PlanItem_06xryvs">
          <cmmn:standardEvent>occur</cmmn:standardEvent>
        </cmmn:planItemOnPart>
      </cmmn:sentry>

      <cmmn:sentry id="Sentry_anhoerung">
        <cmmn:planItemOnPart id="OnPart_anh_1" sourceRef="PlanItem_0br7vvk">
          <cmmn:standardEvent>complete</cmmn:standardEvent>
        </cmmn:planItemOnPart>
      </cmmn:sentry>

    </cmmn:casePlanModel>

    <!-- ============ Text annotations (the source of the assumptions) ============ -->
    <cmmn:textAnnotation id="TextAnnotation_1g2goyg">
      <cmmn:text>Sobald beide Tasks erledigt</cmmn:text>
    </cmmn:textAnnotation>
    <cmmn:textAnnotation id="TextAnnotation_00m7x3z">
      <cmmn:text>Sobald beide Tasks erledigt</cmmn:text>
    </cmmn:textAnnotation>
    <cmmn:textAnnotation id="TextAnnotation_1s45p3q">
      <cmmn:text>Sobald die 3 Tasks erledigt</cmmn:text>
    </cmmn:textAnnotation>
    <cmmn:textAnnotation id="TextAnnotation_0v3mufb">
      <cmmn:text>Antrag gestellt</cmmn:text>
    </cmmn:textAnnotation>
    <cmmn:textAnnotation id="TextAnnotation_0ez19g4">
      <cmmn:text>Person erfasst</cmmn:text>
    </cmmn:textAnnotation>
    <cmmn:textAnnotation id="TextAnnotation_1q8az8a">
      <cmmn:text>Antrag registriert</cmmn:text>
    </cmmn:textAnnotation>

    <cmmn:association id="Association_124lu71" sourceRef="EntryCriterion_1hlbicy" targetRef="TextAnnotation_1g2goyg"/>
    <cmmn:association id="Association_17ys2lt" sourceRef="EntryCriterion_0e3qzys" targetRef="TextAnnotation_00m7x3z"/>
    <cmmn:association id="Association_1wd14bl" sourceRef="EntryCriterion_16pe5b9" targetRef="TextAnnotation_1s45p3q"/>
    <cmmn:association id="Association_1n9buei" sourceRef="EntryCriterion_1dzva64" targetRef="TextAnnotation_0v3mufb"/>
    <cmmn:association id="Association_1dxljbs" sourceRef="EntryCriterion_11tvsx7" targetRef="TextAnnotation_0ez19g4"/>
    <cmmn:association id="Association_03rg4bw" sourceRef="EntryCriterion_147bq4o" targetRef="TextAnnotation_1q8az8a"/>
  </cmmn:case>

  <!-- ============ Diagram interchange ============
       Coordinates copied verbatim from the supplied SVG. The importer derives
       stage ordering from these, so they are load-bearing, not decoration. -->
  <cmmndi:CMMNDI>
    <cmmndi:CMMNDiagram id="CMMNDiagram_asyl_verfahren">
      <cmmndi:CMMNShape id="Shape_CasePlanModel_09iqv6o" cmmnElementRef="CasePlanModel_09iqv6o">
